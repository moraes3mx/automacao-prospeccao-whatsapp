    <!-- Interactive JavaScript -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Mobile Menu Toggle
            const mobileMenuBtn = document.getElementById('mobile-menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');
            const mobileLinks = document.querySelectorAll('.mobile-link');

            if (mobileMenuBtn && mobileMenu) {
                mobileMenuBtn.addEventListener('click', function() {
                    mobileMenu.classList.toggle('hidden');
                });

                mobileLinks.forEach(link => {
                    link.addEventListener('click', () => {
                        mobileMenu.classList.add('hidden');
                    });
                });
            }
        });

        // Handle Interactive WhatsApp Budget Estimator
        function handleQuoteSubmit(event) {
            event.preventDefault();

            // 1. Get Project Type
            const projectTypeElement = document.querySelector('input[name="projectType"]:checked');
            const projectType = projectTypeElement ? projectTypeElement.value : 'Site / Landing Page';

            // 2. Get Selected Features
            const featureElements = document.querySelectorAll('input[name="features"]:checked');
            const selectedFeatures = Array.from(featureElements).map(el => el.value);

            // 3. Get User Details
            const clientName = document.getElementById('clientName').value.trim();
            const clientSegment = document.getElementById('clientSegment').value.trim();

            // 4. Build Custom WhatsApp Message
            let message = `*Olá João Victor! Gostaria de um orçamento para o meu negócio.*\n\n`;
            message += `👤 *Nome / Empresa:* ${clientName}\n`;
            if (clientSegment) {
                message += `🏢 *Ramo:* ${clientSegment}\n`;
            }
            message += `🚀 *Tipo de Projeto:* ${projectType}\n`;

            if (selectedFeatures.length > 0) {
                message += `✨ *Recursos Desejados:* ${selectedFeatures.join(', ')}\n`;
            }

            message += `\nPodemos conversar sobre valores e prazos?`;

            // Encode for URL
            const encodedMessage = encodeURIComponent(message);
            const whatsappNumber = '5571993794205';
            const whatsappURL = `https://wa.me/${whatsappNumber}?text=${encodedMessage}`;

            // Redirect to WhatsApp
            window.open(whatsappURL, '_blank');
        }
    </script>
